# Dependencies — 500MB of them, and reproducible from package-lock.json
shell/node_modules/
node_modules/

# Electron build output
shell/dist/
shell/out/
shell/release/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editor
.vscode/
.idea/
*.swp

# Scratch. _to_delete is the holding pen for things the bridge cannot delete.
_build/_to_delete/
*.log

# The desktop app's download folder. Every file I send lands here, so this
# would otherwise commit a fresh 27,000-line copy of the game every session.
Claude outputs/

# Derived: build-beta.py regenerates this from apps/ + shared/ on demand.
_build/webbeta-dist/

# Backups the patch scripts write beside anything they edit.
*.bak

# python bytecode from the FractureCore trainer
__pycache__/
*.pyc

# Holding pen for files the desktop bridge could not delete, anywhere.
_to_delete/

# Point-in-time safety snapshots (tarballs of source and saves).
_build/snapshot-*/

# Screenshots and scratch the test harness writes.
_test/out/

# Pre-release copies of a game file, kept beside it until the release is committed.
apps/*/index.v*-backup.html
!apps/fracture-city-game/index.v0.2.0-backup.html

# Applied patch sources for a single app; the result lives in index.html.
apps/*/_patches/
# Your own music, art and clips (Palm Radio, billboards)
media/

# Private online accounts, sessions, saves and database backups
server/data/
server/**/*.sqlite
server/**/*.sqlite-wal
server/**/*.sqlite-shm

# Generated release archives and deploy trees
_build/*.zip
_build/netlify-mobile/

# Device-local saves, drafts, profiles and cached feeds
/data/
